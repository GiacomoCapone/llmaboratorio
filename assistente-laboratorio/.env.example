LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Inserire un id restituito da GET /v1/models
LMSTUDIO_MODEL=
MAX_PASSAGGI=5
LOG_LEVEL=INFO
# Ragionamento del modello: none (veloce), low, medium, high
LMSTUDIO_REASONING_EFFORT=none
# Fuso usato quando la domanda non indica un luogo (nome IANA)
FUSO_PREDEFINITO=Europe/Rome
# Città del santo patrono (festività locale): una di quelle in src/assistente/strumenti/festivita.json
CITTA_PATRONO=Pordenone
# Database delle note (SQLite); vuoto = dati/note.db nella cartella del progetto
# NOTE_DB=dati/note.db
# Descrizione dell'ambito usata dal router; vuoto = ambito.txt nella cartella del progetto
# AMBITO_FILE=ambito.txt
# Volte in cui il revisore può rimandare la risposta all'agente (intero >= 1)
MAX_REVISIONI=2
# Token stimati della cronologia oltre i quali i messaggi vecchi sono riassunti
RIASSUNTO_SOGLIA_TOKEN=3000
# Indirizzo e porta del servizio HTTP (python avvia.py --http)
# HTTP_HOST=127.0.0.1
# HTTP_PORTA=8000
# Database PostgreSQL delle conversazioni (python avvia.py --backend e servizio Compose postgres).
# Tenere DATABASE_URL allineato a POSTGRES_* (Compose costruisce il suo dal resto)
POSTGRES_USER=laboratorio
POSTGRES_DB=laboratorio
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://laboratorio:<password>@127.0.0.1:5433/laboratorio
# Back-end delle conversazioni: indirizzo dell'agente, attesa di un turno (s), indirizzo e porta
# AGENTE_URL=http://127.0.0.1:8000
# AGENTE_TIMEOUT=900
# BACKEND_HOST=127.0.0.1
# BACKEND_PORTA=8001
# Front-end (python avvia.py --frontend): indirizzo del back-end, attesa massima (s), indirizzo e porta
# BACKEND_URL=http://127.0.0.1:8001
# BACKEND_TIMEOUT=960
# FRONTEND_HOST=127.0.0.1
# FRONTEND_PORTA=8002
