LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Inserire un id restituito da GET /v1/models
LMSTUDIO_MODEL=
MAX_PASSAGGI=5
LOG_LEVEL=INFO
# Ragionamento del modello: none (veloce), low, medium, high
LMSTUDIO_REASONING_EFFORT=none
# Fuso usato quando la domanda non indica un luogo (nome IANA)
FUSO_PREDEFINITO=Europe/Rome
# Città del santo patrono (festività locale): una di quelle in src/assistente/strumenti/festivita.json
CITTA_PATRONO=Pordenone
# Database delle note (SQLite); vuoto = dati/note.db nella cartella del progetto
# NOTE_DB=dati/note.db
